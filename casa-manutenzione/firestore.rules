rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      allow create: if signedIn();
      allow read, update: if isMember(hid);

      // Chi conosce il codice (hid, lungo e casuale) può aggiungere sé stesso.
      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read: if isMember(hid);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /items/{id} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
